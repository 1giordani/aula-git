{
  "title": "E-commerce — modelo conceitual refinado",
  "author": "Giordani Martins Silva",
  "entities": {
    "cliente": {
      "label": "CLIENTE",
      "fields": [
        "PK id_cliente",
        "tipo_cliente: PF | PJ",
        "nome_exibicao",
        "email"
      ],
      "notes": "Especialização total e exclusiva (XOR)"
    },
    "pf": {
      "label": "PESSOA FÍSICA",
      "fields": [
        "PK, FK id_cliente",
        "UK cpf",
        "nome_completo"
      ],
      "notes": ""
    },
    "pj": {
      "label": "PESSOA JURÍDICA",
      "fields": [
        "PK, FK id_cliente",
        "UK cnpj",
        "razao_social"
      ],
      "notes": ""
    },
    "forma": {
      "label": "FORMA DE PAGAMENTO",
      "fields": [
        "PK id_forma",
        "FK id_cliente",
        "tipo: cartão | PIX | boleto",
        "apelido / referência do provedor"
      ],
      "notes": ""
    },
    "pedido": {
      "label": "PEDIDO",
      "fields": [
        "PK id_pedido",
        "FK id_cliente",
        "data_criacao, status_pedido",
        "endereco_entrega_snapshot",
        "frete, desconto"
      ],
      "notes": ""
    },
    "pagamento": {
      "label": "PAGAMENTO",
      "fields": [
        "PK id_pagamento",
        "FK id_pedido",
        "FK id_forma",
        "valor, status_pagamento",
        "data_pagamento (opcional)"
      ],
      "notes": ""
    },
    "entrega": {
      "label": "ENTREGA",
      "fields": [
        "PK id_entrega",
        "UK, FK id_pedido",
        "status_entrega, transportadora",
        "codigo_rastreio (condicional)",
        "UK (transportadora, codigo_rastreio)"
      ],
      "notes": ""
    },
    "produto": {
      "label": "PRODUTO",
      "fields": [
        "PK id_produto",
        "descricao",
        "categoria"
      ],
      "notes": ""
    },
    "item": {
      "label": "ITEM DO PEDIDO",
      "fields": [
        "PK, FK id_pedido",
        "PK numero_item",
        "FK id_oferta",
        "quantidade",
        "preco_unitario_praticado"
      ],
      "notes": ""
    },
    "oferta": {
      "label": "OFERTA",
      "fields": [
        "PK id_oferta",
        "FK id_produto",
        "FK id_vendedor",
        "preco_atual, ativo",
        "UK (id_produto, id_vendedor)"
      ],
      "notes": ""
    },
    "vendedor": {
      "label": "VENDEDOR",
      "fields": [
        "PK id_vendedor",
        "nome / razao_social",
        "tipo: plataforma | terceiro"
      ],
      "notes": ""
    },
    "fornecedor": {
      "label": "FORNECEDOR",
      "fields": [
        "PK id_fornecedor",
        "UK cnpj",
        "razao_social"
      ],
      "notes": ""
    },
    "fornecimento": {
      "label": "FORNECIMENTO",
      "fields": [
        "PK, FK id_fornecedor",
        "PK, FK id_produto",
        "referencia_fornecedor"
      ],
      "notes": ""
    },
    "estoque": {
      "label": "ESTOQUE",
      "fields": [
        "PK id_estoque",
        "localizacao"
      ],
      "notes": ""
    },
    "produto_estoque": {
      "label": "PRODUTO NO ESTOQUE",
      "fields": [
        "PK, FK id_produto",
        "PK, FK id_estoque",
        "quantidade_disponivel"
      ],
      "notes": ""
    }
  },
