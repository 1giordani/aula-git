      "child": "os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "id_veiculo"
      ],
      "label": "recebe"
    },
    {
      "parent": "equipe",
      "child": "os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "id_equipe"
      ],
      "label": "avalia e executa"
    },
    {
      "parent": "os",
      "child": "autorizacao",
      "parent_card": "1",
      "child_card": "0..1",
      "fk_fields": [
        "numero_os"
      ],
      "label": "recebe decisão"
    },
    {
      "parent": "cliente",
