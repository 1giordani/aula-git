{
  "title": "Oficina mecânica — esquema conceitual",
  "author": "Giordani Martins Silva",
  "entities": {
    "cliente": {
      "label": "CLIENTE",
      "fields": [
        "PK id_cliente",
        "nome",
        "telefone, email",
        "endereco"
      ],
      "notes": ""
    },
    "veiculo": {
      "label": "VEÍCULO",
      "fields": [
        "PK id_veiculo",
        "FK id_cliente_atual",
        "UK placa",
        "marca, modelo, ano"
      ],
      "notes": ""
    },
    "equipe": {
      "label": "EQUIPE",
      "fields": [
        "PK id_equipe",
        "nome_equipe"
      ],
      "notes": ""
    },
    "mecanico": {
      "label": "MECÂNICO",
      "fields": [
        "PK codigo_mecanico",
        "nome",
        "endereco",
        "especialidade"
      ],
      "notes": ""
    },
    "composicao": {
      "label": "COMPOSIÇÃO DA EQUIPE",
      "fields": [
        "PK, FK id_equipe",
        "PK, FK codigo_mecanico",
        "PK data_inicio",
        "data_fim (opcional)"
      ],
      "notes": ""
    },
    "os": {
      "label": "ORDEM DE SERVIÇO",
      "fields": [
        "PK numero_os",
        "FK id_cliente_solicitante",
        "FK id_veiculo",
        "FK id_equipe",
        "data_emissao",
        "data_prevista_conclusao",
        "data_efetiva_conclusao (opcional)",
        "tipo_atendimento: reparo | revisão",
        "status",
        "valor_total (derivado)"
      ],
      "notes": ""
    },
    "autorizacao": {
      "label": "AUTORIZAÇÃO",
      "fields": [
        "PK id_autorizacao",
        "UK, FK numero_os",
        "FK id_cliente",
        "decisao: autorizada | recusada",
        "data_decisao",
        "valor_orcado"
      ],
      "notes": ""
    },
    "servico": {
      "label": "SERVIÇO / MÃO DE OBRA",
      "fields": [
        "PK id_servico",
        "descricao",
        "unidade_cobranca: hora | serviço",
        "valor_unitario_referencia"
      ],
      "notes": ""
    },
    "servico_os": {
      "label": "SERVIÇO DA OS",
      "fields": [
        "PK, FK numero_os",
        "PK, FK id_servico",
        "quantidade",
        "valor_unitario_aplicado",
        "subtotal (derivado)"
      ],
      "notes": ""
    },
    "peca": {
      "label": "PEÇA",
      "fields": [
        "PK id_peca",
        "descricao",
        "valor_unitario_referencia"
      ],
      "notes": ""
    },
    "peca_os": {
      "label": "PEÇA DA OS",
      "fields": [
        "PK, FK numero_os",
        "PK, FK id_peca",
        "quantidade",
        "valor_unitario_aplicado",
        "subtotal (derivado)"
      ],
      "notes": ""
    }
  },
  "relations": [
    {
      "parent": "cliente",
      "child": "veiculo",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
