      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "codigo_mecanico"
      ],
      "label": "integra"
    },
    {
      "parent": "os",
      "child": "servico_os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "numero_os"
      ],
      "label": "inclui serviço"
    },
    {
      "parent": "servico",
      "child": "servico_os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "id_servico"
      ],
      "label": "referencia"
    },
    {
      "parent": "os",
      "child": "peca_os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "numero_os"
      ],
      "label": "inclui peça"
    },
    {
      "parent": "peca",
      "child": "peca_os",
      "parent_card": "1",
      "child_card": "0..N",
      "fk_fields": [
        "id_peca"
      ],
      "label": "referencia"
    }
  ],
